# --- ALT+Up / ALT+Down: cycle through lines of a local .commands file (zsh ZLE) ---
# --- Down (on an untouched prompt) or ALT+Down with nothing left to cycle
#     down to: pick a command from a list ---
#
# .commands format:
#   ccusage --version                 # ccusage version
#   npm install -g ccusage@latest     # install latest npm packages
# Everything after the first " #" is the description and is never inserted
# into the command line. Lines starting with # are comments and are ignored.
#
# Groups: a line followed by more deeply indented lines (4 spaces or a tab
# per level) becomes a group holding them; groups can be nested.
#   MySQL
#       autossh -M 3309 -Ng -L 3308:10.0.0.9:3306 me@example.com
#       # Prod DB
#           mysql -h 127.0.0.1 -P 3308 -u me ridesharing -A
# Titles: a # line with a single, more deeply indented command under it names
# that command ("Prod DB" above). The picker shows the title; → reveals the
# real command. A # line with several lines under it is just a group.
# The picker shows groups as folders (→/⏎ open, ← back;
# esc / ctrl-c, or ← at the top level, close the picker); ALT+Up/Down
# cycle through every command, nested or not, in file order.

_commands_file=".commands"
_commands=()               # every command, flat, in file order
_commands_desc=()
_commands_index=0
# tree of the file: node n is a group when _nodes_cmd[n] == 0, otherwise the
# command _commands[_nodes_cmd[n]]; _nodes_parent[n] == 0 means top level
_nodes_text=()
_nodes_parent=()
_nodes_cmd=()
_cmd_node=()               # _commands index -> node index
_cmd_log() { echo "[$(date '+%H:%M:%S')] $1" >> ~/.command-logs; }

_cmd_trim() {  # trims leading/trailing whitespace of $1 into REPLY
    local s=$1
    s=${s#"${s%%[!$' \t']*}"}
    s=${s%"${s##*[!$' \t']}"}
    REPLY=$s
}

_load_commands() {
    _commands=()
    _commands_desc=()
    _commands_index=0
    _nodes_text=() _nodes_parent=() _nodes_cmd=() _cmd_node=()
    if [[ -f "$_commands_file" ]]; then
        local line lead tabs cmd desc i n
        local -a texts descs widths titled
        # `|| [[ -n "$line" ]]` picks up a last line that has no trailing newline
        while IFS= read -r line || [[ -n "$line" ]]; do
            lead=${line%%[!$' \t']*}
            tabs=${lead//[^$'\t']/}                 # a tab counts as 4 spaces
            _cmd_trim "$line"; line=$REPLY
            [[ -z "$line" ]] && continue
            if [[ "$line" == \#* ]]; then           # title or plain comment
                while [[ "$line" == \#* ]]; do line=${line#\#}; done
                _cmd_trim "$line"
                texts+=("$REPLY")
                descs+=("")
                widths+=($(( ${#lead} + 3 * ${#tabs} )))
                titled+=(1)
                continue
            fi
            cmd=$line
            desc=""
            if [[ "$line" == *" #"* ]]; then
                cmd=${line%% #*}
                desc=${line#* #}
                _cmd_trim "$desc"; desc=$REPLY
            fi
            _cmd_trim "$cmd"; cmd=$REPLY
            [[ -z "$cmd" ]] && continue
            texts+=("$cmd")
            descs+=("$desc")
            widths+=($(( ${#lead} + 3 * ${#tabs} )))
            titled+=(0)
        done < "$_commands_file"

        # a # line is a title only when the next line is indented deeper;
        # any other # line is a plain comment and is dropped here
        local -a keep
        for (( i = 1; i <= ${#texts}; i++ )); do
            (( titled[i] && (i == ${#texts} || widths[i + 1] <= widths[i]) )) || keep+=($i)
        done
        local -a t2 d2 w2 h2
        for i in $keep; do
            t2+=("${texts[i]}") d2+=("${descs[i]}") w2+=(${widths[i]}) h2+=(${titled[i]})
        done
        texts=("${t2[@]}") descs=("${d2[@]}") widths=("${w2[@]}") titled=("${h2[@]}")

        # Python-style nesting: a line is a group when the next line is indented
        # deeper; a stack of (indent, node) pairs tracks the open groups.
        # A title holding exactly one command (nothing nested under it) names
        # that command; a title holding more is just a group.
        local -a stackw=(-1) stackn=(0)
        for (( i = 1; i <= ${#texts}; i++ )); do
            while (( widths[i] <= ${stackw[-1]} )); do
                stackw[-1]=() stackn[-1]=()
            done
            _nodes_text+=("${texts[i]}")
            _nodes_parent+=(${stackn[-1]})
            n=${#_nodes_text}
            if (( titled[i] && !titled[i + 1] &&
                  (i + 1 == ${#texts} || widths[i + 2] <= widths[i]) )); then
                (( i++ ))                       # the command line is consumed
                _commands+=("${texts[i]}")
                _commands_desc+=("${descs[i]}")
                _nodes_cmd+=(${#_commands})
                _cmd_node+=($n)
            elif (( i < ${#texts} && widths[i + 1] > widths[i] )); then
                _nodes_cmd+=(0)
                stackw+=(${widths[i]}) stackn+=($n)
            else
                _commands+=("${texts[i]}")
                _commands_desc+=("${descs[i]}")
                _nodes_cmd+=(${#_commands})
                _cmd_node+=($n)
            fi
        done
    fi
    _cmd_log "load_commands: count=${#_commands[@]} index=$_commands_index"
}

# zsh's own stat builtin: no fork per keypress, and unlike `stat(1)` the syntax
# is the same on macOS (BSD) and Linux (GNU coreutils)
zmodload -F zsh/stat b:zstat 2>/dev/null

_commands_mtime=0
_maybe_reload_commands() {
    local -a st
    if [[ -f "$_commands_file" ]]; then
        zstat -A st +mtime "$_commands_file" 2>/dev/null || return
        if [[ "$st[1]" != "$_commands_mtime" ]]; then
            _load_commands
            _commands_mtime="$st[1]"
            _commands_index=${#_commands[@]}
        fi
    fi
}

# Refreshes the list and succeeds only when there is something to offer.
_have_commands() {
    _maybe_reload_commands
    (( ${#_commands[@]} == 0 )) && _load_commands
    (( ${#_commands[@]} > 0 ))
}

# zsh arrays are 1-based; _commands_index keeps bash-style 0-based semantics,
# so the element is _commands[_commands_index + 1]
_cycle_commands() {        # ALT+UP
    _maybe_reload_commands
    if [[ ${#_commands[@]} -eq 0 ]]; then
        _load_commands
        _commands_index=${#_commands[@]}
    fi
    if [[ -z "$BUFFER" && $_commands_index -lt ${#_commands[@]} ]]; then
        _commands_index=${#_commands[@]}
    fi
    if [[ $_commands_index -gt 0 ]]; then
        _commands_index=$(( _commands_index - 1 ))
        BUFFER="${_commands[$(( _commands_index + 1 ))]}"
        CURSOR=${#BUFFER}
    fi
}

_cycle_commands_down() {   # ALT+DOWN
    _maybe_reload_commands
    if [[ ${#_commands[@]} -eq 0 ]]; then
        return
    fi
    # not in a cycle (nothing left to cycle down to) -> open the picker instead
    if [[ $_commands_index -ge ${#_commands[@]} ]]; then
        _pick_command
        return
    fi
    if [[ $_commands_index -lt $(( ${#_commands[@]} - 1 )) ]]; then
        _commands_index=$(( _commands_index + 1 ))
        BUFFER="${_commands[$(( _commands_index + 1 ))]}"
        CURSOR=${#BUFFER}
    else
        _commands_index=${#_commands[@]}
        BUFFER=""
        CURSOR=0
    fi
}

# ---------------------------------------------------------------------------
# Picker
# ---------------------------------------------------------------------------

# Children of node $1 (0 = top level) into $reply, newest-first (the last line
# of .commands at the top).
_cmd_picker_items() {
    reply=()
    local n
    for (( n = ${#_nodes_parent}; n >= 1; n-- )); do
        (( _nodes_parent[n] == $1 )) && reply+=($n)
    done
}

# Renders the table and returns the selected command index (0-based, into
# _commands) in $REPLY, or -1. $1 is the node to start on (0 = first row of
# the top level); the picker opens inside the group that holds it.
# Draws to and reads from /dev/tty so it is safe inside a ZLE widget.
_cmd_picker_select() {
    local focus=${1:-0} level=0
    (( focus > 0 )) && level=${_nodes_parent[focus]}
    local cols=${COLUMNS:-80} lines=${LINES:-24}
    local -a items
    local total sel top view cmdw maxcmd crumbs relevel=1
    local i w n name drawn=0 key k2 k3 params act reveal=0 color
    _cmd_picker_accept=0                   # 1 = run the command, 0 = only insert
    # inside ZLE ctrl-c arrives as SIGINT, not as a \003 key; left alone it
    # aborts the widget mid-draw, leaving the table up and the cursor hidden.
    # Catch it instead: the trap returns from this function at once (it is
    # removed again when the function ends) and the always block cleans up.
    setopt localoptions localtraps
    trap 'REPLY=-1; return' INT
    printf '\e[?25l' > /dev/tty            # hide cursor

    {
        while :; do
            if (( relevel )); then             # entered or left a group
                relevel=0
                _cmd_picker_items $level; items=("${reply[@]}")
                total=${#items}
                sel=0 top=0
                if (( focus )); then
                    i=${items[(ie)$focus]}
                    (( i <= total )) && sel=$(( i - 1 ))
                fi
                view=$(( lines - 4 ))
                (( view > total )) && view=$total
                (( view < 1 )) && view=1

                # column width; a group row adds "📁 " (3 cells) and " ›" (2)
                cmdw=0
                for n in $items; do
                    w=${#_nodes_text[n]}
                    (( _nodes_cmd[n] == 0 )) && (( w += 5 ))
                    (( w > cmdw )) && cmdw=$w
                done
                maxcmd=$(( cols - 3 ))
                (( maxcmd < 20 )) && maxcmd=20
                (( cmdw > maxcmd )) && cmdw=$maxcmd

                crumbs=""
                for (( n = level; n > 0; n = _nodes_parent[n] )); do
                    crumbs="${_nodes_text[n]}${crumbs:+ › }$crumbs"
                done
            fi

            (( sel < top )) && top=$sel
            (( sel > top + view - 1 )) && top=$(( sel - view + 1 ))

            {
                # back to the header, clearing leftovers of a longer previous level
                (( drawn > 0 )) && printf '\e[%dA' $drawn
                printf '\e[J'
                drawn=0

                printf '\e[2K'
                [[ -n $crumbs ]] && printf ' \e[1;34m📁 %s\e[0m' "$crumbs"
                printf '\e[2m  ↑/↓ move · ⏎ run · → open/show · ⌥⏎ insert · '
                (( level )) && printf '← back · '
                printf 'esc cancel'
                (( total > view )) && printf '   (%d/%d)' $(( sel + 1 )) $total
                printf '\e[0m\n'
                (( drawn++ ))

                # descriptions are still parsed into _commands_desc, just not shown
                for (( i = top; i < top + view; i++ )); do
                    n=${items[i + 1]}
                    name=${_nodes_text[n]}
                    if (( _nodes_cmd[n] )); then
                        (( ${#name} > cmdw )) && name="${name[1,cmdw - 1]}…"
                        color=""                            # titles are yellow
                        [[ ${_nodes_text[n]} != ${_commands[_nodes_cmd[n]]} ]] && color=';33'
                        if (( i == sel )); then
                            printf '\e[2K\e[7%sm %-*s \e[0m\n' "${color:+;1$color}" $cmdw "$name"
                        else
                            printf '\e[2K \e[1%sm%-*s\e[0m\n' "$color" $cmdw "$name"
                        fi
                        if (( i == sel && reveal )); then   # → on a titled command
                            name=${_commands[_nodes_cmd[n]]}
                            (( ${#name} > cols - 6 )) && name="${name[1,cols - 7]}…"
                            printf '\e[2K   \e[2m↳ %s\e[0m\n' "$name"
                            (( drawn++ ))
                        fi
                    else
                        (( ${#name} > cmdw - 5 )) && name="${name[1,cmdw - 6]}…"
                        if (( i == sel )); then
                            printf '\e[2K\e[1;7;34m 📁 %-*s \e[0m\n' $(( cmdw - 3 )) "$name ›"
                        else
                            printf '\e[2K \e[1;34m📁 %-*s\e[0m\n' $(( cmdw - 3 )) "$name ›"
                        fi
                    fi
                    (( drawn++ ))
                done
            } > /dev/tty

            IFS= read -rs -k 1 key < /dev/tty || { REPLY=-1; break; }
            act=""
            case $key in
                $'\n'|$'\r')  act=run ;;
                'k'|$'\020')  act=prev ;;              # k / ctrl-p
                'j'|$'\016')  act=next ;;              # j / ctrl-n
                'l')          act=open ;;
                'h')          act=back ;;
                'q'|$'\003')  act=cancel ;;            # q / ctrl-c
                $'\e')
                    if ! IFS= read -rs -k 1 -t 0.05 k2 < /dev/tty; then
                        act=cancel                            # bare ESC
                    # ALT+Return as "ESC then CR" -> insert without running
                    elif [[ $k2 == $'\r' || $k2 == $'\n' ]]; then
                        act=insert
                    elif [[ $k2 == '[' || $k2 == 'O' ]]; then
                        IFS= read -rs -k 1 -t 0.2 k3 < /dev/tty || continue
                        # collect modifier params of sequences like ESC [ 1;3 A
                        params=""
                        while [[ $k3 == [0-9\;] ]]; do
                            params+=$k3
                            IFS= read -rs -k 1 -t 0.2 k3 < /dev/tty || break
                        done
                        case $k3 in
                            A) act=up ;;
                            B) act=next ;;
                            C) act=open ;;
                            D) act=back ;;
                            H) act=home ;;
                            F) act=end ;;
                            # ALT+Return reported by modifyOtherKeys (ESC [ 27;3;13 ~)
                            # or by the kitty keyboard protocol (ESC [ 13;3 u)
                            '~'|'u') [[ $params == (27\;*\;13|13\;*) ]] && act=insert ;;
                        esac
                    fi
                    ;;
            esac

            n=${items[sel + 1]}
            # a revealed command hides again on ← and on any other key
            if (( reveal )); then
                reveal=0
                [[ $act == back ]] && continue
            fi
            # on a group, ⏎ / ⌥⏎ open it like →
            [[ $act == (run|insert) ]] && (( _nodes_cmd[n] == 0 )) && act=open
            # ← steps out of a group, and only leaves the picker at the top level
            [[ $act == back ]] && (( level == 0 )) && act=cancel
            case $act in
                up)     # Up on the top row of the top level leaves the picker
                        if (( sel > 0 )); then (( sel-- ))
                        elif (( level == 0 )); then REPLY=-1; break; fi ;;
                prev)   (( sel > 0 )) && (( sel-- )) ;;
                next)   (( sel < total - 1 )) && (( sel++ )) ;;
                home)   sel=0 ;;
                end)    sel=$(( total - 1 )) ;;
                open)   if (( _nodes_cmd[n] == 0 )); then
                            level=$n focus=0 relevel=1
                        elif [[ ${_nodes_text[n]} != ${_commands[_nodes_cmd[n]]} ]]; then
                            reveal=1           # titled: show the real command
                        fi ;;
                back)   if (( level )); then   # land on the group we came from
                            focus=$level level=${_nodes_parent[level]} relevel=1
                        fi ;;
                run)    _cmd_picker_accept=1
                        REPLY=$(( _nodes_cmd[n] - 1 )); break ;;
                insert) REPLY=$(( _nodes_cmd[n] - 1 )); break ;;
                cancel) REPLY=-1; break ;;
            esac
        done
    } always {
        # erase the table
        (( drawn > 0 )) && printf '\e[%dA' $drawn > /dev/tty
        printf '\e[J\e[?25h' > /dev/tty    # clear below + show cursor
    }
}

_pick_command() {          # opened from _cycle_commands_down (ALT+DOWN)
    # with nothing to pick from the picker stays closed and says nothing
    _have_commands || return 1

    # start on the currently cycled command (inside its group, if nested)
    local start=0
    (( _commands_index < ${#_commands[@]} )) && \
        start=${_cmd_node[_commands_index + 1]}

    print -rn -- $'\n' > /dev/tty          # room below the prompt
    _cmd_picker_select $start
    local picked=$REPLY
    printf '\e[1A\e[2K' > /dev/tty         # reclaim that line

    if (( picked >= 0 )); then
        _commands_index=$picked
        BUFFER="${_commands[picked + 1]}"
        CURSOR=${#BUFFER}
        if (( _cmd_picker_accept )); then
            _commands_index=${#_commands[@]}   # selection ends the cycle
            zle accept-line
            return
        fi
    fi
    zle redisplay
}

# Plain DOWN: open the picker only on an untouched prompt — empty buffer and
# not browsing shell history (HISTNO == HISTCMD means we are on the fresh line).
# Mid .commands cycle it keeps cycling; anything else falls through to zsh.
_down_or_pick() {          # DOWN
    _maybe_reload_commands
    if (( _commands_index < ${#_commands[@]} )); then
        _cycle_commands_down
    elif [[ -z "$BUFFER" ]] && (( HISTNO == HISTCMD )) && _pick_command; then
        :   # the picker handled the key
    else
        zle .down-line-or-history
    fi
}

# A cycle lives only as long as the line being edited: once a line is run
# (e.g. one inserted with ⌥⏎ and then run with a plain ⏎), the next prompt
# starts fresh, so Down opens the picker instead of cycling on
_commands_end_cycle() { _commands_index=${#_commands[@]}; }
autoload -Uz add-zsh-hook
add-zsh-hook precmd _commands_end_cycle

zle -N _cycle_commands
zle -N _cycle_commands_down
zle -N _pick_command
zle -N _down_or_pick
bindkey '^[[1;3A' _cycle_commands
bindkey '^[[1;3B' _cycle_commands_down
bindkey '^[[B'    _down_or_pick     # plain Down (application mode: ^[OB)
bindkey '^[OB'    _down_or_pick

# the picker has no binding of its own — ALT+Down opens it when not cycling
